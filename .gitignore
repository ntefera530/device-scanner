# --- Dependencies ---
node_modules/
jspm_packages/
web_modules/

# --- TypeScript & Build Outputs ---
# Blocks compiled JavaScript and source maps from going into Git
dist/
build/
out/
lib/
*.tsbuildinfo
*.js.map

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment and Secrets ---
# Never commit credentials or API keys to version control
.env
.env.local
.env.*.local
*.env

# --- Testing ---
coverage/
.nyc_output/

# --- IDEs and Editors ---
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Operating System Files ---
.DS_Store
Thumbs.db

# --- config files ---
src/devices.config.ts
